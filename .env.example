# Copy to .env.local for local development, or set these in your host's
# environment settings when deploying. See docs/UNSUBSCRIBE.md.

# Signs unsubscribe tokens. Generate with: openssl rand -base64 32
# Must match in this app and in whatever sends the daily email, or every
# unsubscribe link will read as invalid. Rotating it invalidates all
# outstanding links.
UNSUBSCRIBE_TOKEN_SECRET=

# Where opt-outs are written.
#   webhook  - production. Posts to SUBSCRIBER_WEBHOOK_URL.
#   file     - local development only; refused when NODE_ENV=production.
UNSUBSCRIBE_STORE=webhook

# Endpoint on whatever system owns the subscriber list. Receives
# POST { "action": "unsubscribe", "email": "..." } and must mark the address
# opted out where the daily send job reads its recipients.
SUBSCRIBER_WEBHOOK_URL=

# Sent as the x-unsubscribe-secret header; verify it on the receiving end.
SUBSCRIBER_WEBHOOK_SECRET=

# Origin used when building unsubscribe links.
# Defaults to https://www.fabfouracademy.com
NEXT_PUBLIC_SITE_URL=
